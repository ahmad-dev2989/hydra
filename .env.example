# 1. Nebius Token Factory API Key (Required for Hackathon Cloud Inference)
# Get your API key from https://tokenfactory.nebius.com or https://studio.nebius.ai
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY_HERE

# 2. Nebius Token Factory Base URL (OpenAI-compatible endpoint)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# 3. NVIDIA Open-Source Models Hosted on Nebius Token Factory
# Low-latency model for real-time conversation & intent extraction
NEBIUS_FAST_MODEL=nebius/nvidia/Nemotron-3_5-Lightning

# Deep reasoning & coding model for autonomous agents, code synthesis & file workflows
NEBIUS_REASONING_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b

# 4. User Persona Configuration
HYDRA_MASTER_NAME=Ahmad Farooq
